# =============================================================================
# PINNED PACK RELEASE -- single source of truth for the deployed version.
#
# Mythic Prehistory is OUR pack, not a third-party download. Prism supplies the
# ignored base mods/ directory; repo-added server mods are hash-pinned in the
# Dockerfile. There is no single upstream pack zip.
#
# Authored in Prism Launcher:
#   ~/Library/Application Support/PrismLauncher/instances/Mythic Prehistory
# =============================================================================

PACK_NAME="Mythic Prehistory"
PACK_VERSION="1.3.0"
PACK_DISPLAY="MythicPrehistory_v1.3.0"

# Platform. Forge 47.4.22 is what the Prism instance was built and tested on.
MINECRAFT_VERSION="1.20.1"
FORGE_VERSION="47.4.22"
JAVA_MAJOR="17"

# Official Forge installer, served from MinecraftForge's own maven.
FORGE_INSTALLER_URL="https://maven.minecraftforge.net/net/minecraftforge/forge/1.20.1-47.4.22/forge-1.20.1-47.4.22-installer.jar"

# Mod counts, asserted at build time so a silent copy failure cannot ship.
#   127 in the Prism instance after installing Mythic Dinosaur Companions
# -  17 client-only (rendering, HUD, input, tooltip UI) -- see CLIENT_ONLY.txt
# = 110 server-capable Prism jars, plus two server-added jars
CLIENT_MOD_COUNT="136"
SERVER_MOD_COUNT="121"
