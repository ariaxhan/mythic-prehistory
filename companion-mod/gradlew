#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
GRADLE_VERSION="8.8"
GRADLE_SHA256="a4b4158601f8636cdeeab09bd76afb640030bb5b144aafe261a5e8af027dc612"
DIST_ROOT="${GRADLE_USER_HOME:-$SCRIPT_DIR/.gradle-dist}"
GRADLE_DIR="$DIST_ROOT/gradle-$GRADLE_VERSION"
ARCHIVE="$DIST_ROOT/gradle-$GRADLE_VERSION-bin.zip"

if [[ ! -x "$GRADLE_DIR/bin/gradle" ]]; then
    mkdir -p "$DIST_ROOT"
    curl -fsSL --retry 3 -o "$ARCHIVE" "https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip"
    if command -v sha256sum >/dev/null 2>&1; then
        printf '%s  %s\n' "$GRADLE_SHA256" "$ARCHIVE" | sha256sum -c -
    else
        [[ "$(shasum -a 256 "$ARCHIVE" | awk '{print $1}')" == "$GRADLE_SHA256" ]]
    fi
    unzip -q "$ARCHIVE" -d "$DIST_ROOT"
fi

exec "$GRADLE_DIR/bin/gradle" "$@"
