	quests: [
		{
			title: "The Titans Stir"
			x: 0.0d
			y: 0.0d
			subtitle: "Bosses'Rise"
			description: [
				"\u00a7cBosses'Rise\u00a7r seeds this world with true titans: a \u00a7byeti\u00a7r in the frozen peaks, a \u00a7bkraken\u00a7r beneath the waves, a \u00a7bsandworm\u00a7r under the dunes, a \u00a7bknight of the underworld\u00a7r below, and an \u00a7binfernal dragon\u00a7r above them all."
				""
				"Each arena is findable; each fight is a mechanics check, not a stat check. Gear from the Arms chapter, food from the Hearth, and courage from wherever you keep it."
			]
			id: "000000000000022A"
			shape: "star"
			size: 1.5d
			tasks: [
				{
					id: "0000000000000228"
					type: "checkmark"
					title: "Accept the trials"
				}
			]
			rewards: [
				{
					id: "0000000000000229"
					type: "xp"
					xp: 100
				}
			]
		}
		{
			title: "Kill the Yeti"
			x: -2.0d
			y: 1.6d
			subtitle: "Boss: Yeti"
			description: [
				"It lives where the Survival Overhaul says you shouldn't: the deep frozen peaks. Sew the coat first. Then bring it a fight worth waking for."
